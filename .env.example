# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HUMANIZER API CONFIGURATION (Server-Side Only)
HUMANIZER_API_URL=""
HUMANIZER_API_KEY=""
HUMANIZER_MODEL="humanflow-pro-v2"
HUMANIZER_RESPONSE_PATH="data.text"

# AI QUALITY & DETECTION CHECKER API CONFIGURATION (Server-Side Only)
CHECKER_API_URL=""
CHECKER_API_KEY=""
CHECKER_RESPONSE_SCORE_PATH="data.ai_score"

# DISCORD WEBHOOK NOTIFICATIONS
DISCORD_WEBHOOK_URL=""

# DATABASE & SUPABASE CONFIGURATION (Optional - falls back to self-contained persistent store)
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# PIPELINE & SECURITY LIMITS
MAX_RETRIES="3"
MAX_FILE_SIZE_MB="50"
DEFAULT_RETENTION_HOURS="24"
PROCESSING_MODE="DEMO"

